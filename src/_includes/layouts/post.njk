---
layout: layouts/base.njk
---
<article class="wrap post">
  <a class="back" href="/news/">← All news</a>
  <p class="eyebrow"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
  <h1>{{ title }}</h1>
  {% if image %}<img class="post-image" src="{{ image }}" alt="">{% endif %}
  <div class="prose">{{ content | safe }}</div>
  {% if link %}<p><a class="btn btn-primary" href="{{ link }}">Read the full story →</a></p>{% endif %}
</article>
